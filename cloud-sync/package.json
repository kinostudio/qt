{
  "name": "kino-quotation-data-api",
  "private": true,
  "type": "module",
  "scripts": {
    "build:pdf-form": "esbuild src/pdf-form.js --bundle --platform=browser --format=iife --global-name=KinoPdfForm --minify --outfile=../assets/pdf-form.js",
    "dev": "wrangler dev",
    "check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply kino-quotation-data --local",
    "migrate:remote": "wrangler d1 migrations apply kino-quotation-data --remote"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "jose": "^6.1.3",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "wrangler": "^4.156.0"
  }
}
